# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# agent-local planning state
/.pi/

# next.js
/.next/
/out/
/apps/*/.next/
/apps/*/out/

# production
/build
/apps/*/dist/
/apps/*/src-tauri/target/
/apps/*/src-tauri/plugins/*/target/
/apps/*/src-tauri/plugins/*/.tauri/
/apps/*/src-tauri/plugins/*/ios/.build/
/apps/studio/src-tauri/resources/bin/*
!/apps/studio/src-tauri/resources/bin/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime assets copied from node_modules on postinstall
/public/vendor/
/public/coi-serviceworker.js
/apps/web/public/vendor/
/apps/web/public/coi-serviceworker.js
