{
  "name": "rescript-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @rescript/web",
    "dev:studio": "npm run tauri:dev --workspace @rescript/studio",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @rescript/web",
    "build:studio": "npm run build --workspace @rescript/studio",
    "build:macos": "npm run tauri:build:macos --workspace @rescript/studio",
    "tauri": "npm run tauri --workspace @rescript/studio --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "postinstall": "npm run assets --workspace @rescript/web"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
