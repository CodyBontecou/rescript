{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rescript",
  "version": "0.1.0",
  "identifier": "tech.isolated.rescript",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @rescript/studio",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace @rescript/studio",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rescript",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/projects/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/bin/*": "bin/"
    },
    "category": "Productivity",
    "shortDescription": "Private transcript-based media editing",
    "longDescription": "Edit audio and video by editing a local, on-device transcript.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "iOS": {
      "minimumSystemVersion": "17.0"
    }
  }
}
